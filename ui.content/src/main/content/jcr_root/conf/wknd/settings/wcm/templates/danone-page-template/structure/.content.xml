<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[mobile/groups/responsive]"
        cq:lastReplicated="{Date}2023-09-15T11:00:00.000-07:00"
        cq:lastReplicated_preview="{Date}2023-09-15T11:00:00.000-07:00"
        cq:lastReplicatedBy="admin"
        cq:lastReplicationAction="Activate"
        cq:lastReplicationAction_preview="Activate"
        cq:template="/conf/wknd/settings/wcm/templates/danone-page-template"
        jcr:mixinTypes="[cq:ReplicationStatus]"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="wknd/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wknd/components/container"
            layout="responsiveGrid">
            <danone-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wknd/components/danone-header"
                navigationRoot="/content/wknd/language-masters/en"
                jobsUrl="#"
                jobsLabel="JOBS"/>
            <container
                cq:styleIds="[1554340406437]"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wknd/components/container"
                editable="{Boolean}true"/>
            <danone-footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wknd/components/danone-footer"
                jobsAllUrl="#"
                jobsAllLabel="ALL UK AND IRELAND JOBS"
                copyrightText="COOKIES | PRIVACY POLICY | DANONE.COM"/>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                    jcr:primaryType="nt:unstructured"
                    title="Smaller Screen"
                    width="{Long}768"/>
                <tablet
                    jcr:primaryType="nt:unstructured"
                    title="Tablet"
                    width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
